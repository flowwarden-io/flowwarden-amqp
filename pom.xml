<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.2.12</version>
        <relativePath/>
    </parent>

    <groupId>io.flowwarden</groupId>
    <artifactId>flowwarden-amqp</artifactId>
    <version>1.0.0-rc.3-SNAPSHOT</version>
    <packaging>jar</packaging>

    <name>FlowWarden AMQP</name>
    <description>AMQP 0.9.1 publish-only DlqStore implementation for FlowWarden Stream Core — publishes failed events to a topic exchange (RabbitMQ canonical, also LavinMQ / Qpid / ActiveMQ Classic / CloudAMQP).</description>
    <url>https://github.com/flowwarden-io/flowwarden-amqp</url>

    <licenses>
        <license>
            <name>Apache License, Version 2.0</name>
            <url>https://www.apache.org/licenses/LICENSE-2.0</url>
            <distribution>repo</distribution>
        </license>
    </licenses>

    <inceptionYear>2026</inceptionYear>

    <organization>
        <name>FlowWarden</name>
        <url>https://flowwarden.io</url>
    </organization>

    <developers>
        <developer>
            <id>cedricclausPro</id>
            <name>Cédric Claus</name>
            <email>62853718+cedricclausPro@users.noreply.github.com</email>
            <url>https://github.com/cedricclausPro</url>
            <organization>FlowWarden</organization>
            <organizationUrl>https://flowwarden.io</organizationUrl>
        </developer>
    </developers>

    <scm>
        <connection>scm:git:https://github.com/flowwarden-io/flowwarden-amqp.git</connection>
        <developerConnection>scm:git:git@github.com:flowwarden-io/flowwarden-amqp.git</developerConnection>
        <url>https://github.com/flowwarden-io/flowwarden-amqp</url>
        <tag>HEAD</tag>
    </scm>

    <issueManagement>
        <system>GitHub Issues</system>
        <url>https://github.com/flowwarden-io/flowwarden-amqp/issues</url>
    </issueManagement>

    <properties>
        <java.version>17</java.version>
        <flowwarden-stream-core.version>1.0.0-rc.4</flowwarden-stream-core.version>
        <testcontainers.version>1.21.4</testcontainers.version>
        <license.year>2026</license.year>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>org.testcontainers</groupId>
                <artifactId>testcontainers-bom</artifactId>
                <version>${testcontainers.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>
        <!-- FlowWarden SPI (DlqStore, FailedEvent, DlqPolicy, @ChangeStream, @DeadLetterQueue) -->
        <dependency>
            <groupId>io.flowwarden</groupId>
            <artifactId>flowwarden-stream-core</artifactId>
            <version>${flowwarden-stream-core.version}</version>
        </dependency>

        <!-- Contract tests: adoptable since the stream-core 1.0.0-rc.4 testkit made
             the read/count contracts opt-in — the write contract fits publish-only -->
        <dependency>
            <groupId>io.flowwarden</groupId>
            <artifactId>flowwarden-stream-core-testkit</artifactId>
            <version>${flowwarden-stream-core.version}</version>
            <scope>test</scope>
        </dependency>

        <!-- BSON (transitive optional in flowwarden-stream-core, needed here for FailedEvent fields:
             BsonValue documentKey, BsonDocument resumeToken, Document fullDocument) -->
        <dependency>
            <groupId>org.mongodb</groupId>
            <artifactId>bson</artifactId>
        </dependency>

        <!-- Spring AMQP (RabbitTemplate, AmqpException) -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-amqp</artifactId>
        </dependency>

        <!-- Jackson (FailedEvent JSON serialization in AmqpDlqMessageBuilder) -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-json</artifactId>
        </dependency>

        <!-- Spring Boot auto-configuration -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-autoconfigure</artifactId>
        </dependency>

        <!-- Configuration metadata generation for IDE assistance -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-configuration-processor</artifactId>
            <optional>true</optional>
        </dependency>

        <!-- Test infrastructure -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>

        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>testcontainers</artifactId>
            <scope>test</scope>
        </dependency>

        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>rabbitmq</artifactId>
            <scope>test</scope>
        </dependency>

        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <!-- SNAPSHOTs only: resolves unreleased stream-core snapshots published by
         core CI to GitHub Packages (reads require authentication even for
         public packages — CI uses GITHUB_TOKEN; locally either configure a
         read:packages PAT for server id "github" in ~/.m2/settings.xml or
         `./mvnw install` the core checkout). Releases resolve from Maven
         Central as usual. -->
    <repositories>
        <repository>
            <id>github</id>
            <url>https://maven.pkg.github.com/flowwarden-io/flowwarden-stream-core</url>
            <releases>
                <enabled>false</enabled>
            </releases>
            <snapshots>
                <enabled>true</enabled>
            </snapshots>
        </repository>
    </repositories>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <source>${java.version}</source>
                    <target>${java.version}</target>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <excludes>
                        <exclude>**/*IntegrationTest.java</exclude>
                    </excludes>
                    <argLine>-XX:+EnableDynamicAgentLoading</argLine>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-failsafe-plugin</artifactId>
                <configuration>
                    <includes>
                        <include>**/*IntegrationTest.java</include>
                    </includes>
                    <argLine>-XX:+EnableDynamicAgentLoading</argLine>
                </configuration>
                <executions>
                    <execution>
                        <goals>
                            <goal>integration-test</goal>
                            <goal>verify</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>com.mycila</groupId>
                <artifactId>license-maven-plugin</artifactId>
                <version>5.1.2</version>
                <configuration>
                    <licenseSets>
                        <licenseSet>
                            <header>.license-header.txt</header>
                            <includes>
                                <include>src/**/*.java</include>
                            </includes>
                        </licenseSet>
                    </licenseSets>
                    <properties>
                        <license.year>${license.year}</license.year>
                    </properties>
                </configuration>
                <executions>
                    <execution>
                        <goals>
                            <goal>check</goal>
                        </goals>
                        <phase>verify</phase>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <!--
            Release profile — activated explicitly for Maven Central deployments.
            Usage:  export GPG_TTY=$(tty); ./mvnw -P release clean deploy
            Requires:
              - GPG key configured locally and on Sonatype keyserver
              - credentials for server id 'central' in ~/.m2/settings.xml
        -->
        <profile>
            <id>release</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-source-plugin</artifactId>
                        <executions>
                            <execution>
                                <id>attach-sources</id>
                                <goals>
                                    <goal>jar-no-fork</goal>
                                </goals>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-javadoc-plugin</artifactId>
                        <executions>
                            <execution>
                                <id>attach-javadocs</id>
                                <goals>
                                    <goal>jar</goal>
                                </goals>
                            </execution>
                        </executions>
                        <configuration>
                            <doclint>none</doclint>
                            <source>${java.version}</source>
                        </configuration>
                    </plugin>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-gpg-plugin</artifactId>
                        <executions>
                            <execution>
                                <id>sign-artifacts</id>
                                <phase>verify</phase>
                                <goals>
                                    <goal>sign</goal>
                                </goals>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <groupId>org.sonatype.central</groupId>
                        <artifactId>central-publishing-maven-plugin</artifactId>
                        <version>0.11.0</version>
                        <extensions>true</extensions>
                        <configuration>
                            <publishingServerId>central</publishingServerId>
                            <autoPublish>false</autoPublish>
                            <waitUntil>validated</waitUntil>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>

</project>
